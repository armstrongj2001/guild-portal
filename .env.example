# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API
#
# Both values are safe in the browser — the anon key is designed to be public
# and every table is protected by row-level security. Leave them unset and the
# app runs in demo mode against seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
